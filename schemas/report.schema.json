{
  "$defs": {
    "Counts": {
      "additionalProperties": true,
      "description": "How many measures got each level.",
      "properties": {
        "check": {
          "title": "Check",
          "type": "integer"
        },
        "good": {
          "title": "Good",
          "type": "integer"
        },
        "not_measured": {
          "title": "Not Measured",
          "type": "integer"
        },
        "poor": {
          "title": "Poor",
          "type": "integer"
        }
      },
      "required": [
        "good",
        "check",
        "poor",
        "not_measured"
      ],
      "title": "Counts",
      "type": "object"
    },
    "Interval": {
      "additionalProperties": true,
      "description": "A problem as a time range of the video, in seconds.",
      "properties": {
        "category": {
          "title": "Category",
          "type": "string"
        },
        "category_label": {
          "title": "Category Label",
          "type": "string"
        },
        "check": {
          "description": "The measure that found it",
          "title": "Check",
          "type": "string"
        },
        "check_label": {
          "title": "Check Label",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "doubt": {
          "anyOf": [
            {
              "enum": [
                "asr",
                "asr_or_real"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "asr: probably misheard by speech recognition; asr_or_real: misheard or a real error",
          "title": "Doubt"
        },
        "dub": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Which dub (A, B, ...) in a comparison",
          "title": "Dub"
        },
        "dubbed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the dub says there",
          "title": "Dubbed"
        },
        "end": {
          "title": "End",
          "type": "number"
        },
        "line": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The line it is about, when it is about one",
          "title": "Line"
        },
        "merged": {
          "default": 1,
          "description": "How many findings were merged into this range",
          "title": "Merged",
          "type": "integer"
        },
        "moment": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Index of its moment in the report's moments",
          "title": "Moment"
        },
        "original": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What the original says there",
          "title": "Original"
        },
        "problem": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What is wrong, in a sentence (description holds every part)",
          "title": "Problem"
        },
        "severity": {
          "enum": [
            "check",
            "poor"
          ],
          "title": "Severity",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "number"
        },
        "suggestion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A better translation, when the translation check gave one",
          "title": "Suggestion"
        }
      },
      "required": [
        "start",
        "end",
        "category",
        "category_label",
        "severity",
        "check",
        "check_label",
        "description"
      ],
      "title": "Interval",
      "type": "object"
    },
    "Metric": {
      "additionalProperties": true,
      "description": "One measure: its level, the value behind it, and plain explanations.",
      "properties": {
        "display": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The value as shown to a person",
          "title": "Display"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "level": {
          "enum": [
            "good",
            "check",
            "poor",
            "info",
            "not_measured"
          ],
          "title": "Level",
          "type": "string"
        },
        "message": {
          "description": "What was found, what it means for a viewer, what to do",
          "title": "Message",
          "type": "string"
        },
        "parts": {
          "anyOf": [
            {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The scores inside this measure (the translation check's five criteria), each {id, label, level, value, display, low}",
          "title": "Parts"
        },
        "score_points": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Its points out of 100 in the quality score (Good 100, Poor 0, Needs review by where the result sits between the limits); null when it doesn't count",
          "title": "Score Points"
        },
        "thresholds": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How the level is graded",
          "title": "Thresholds"
        },
        "value": {
          "default": null,
          "description": "The measured number or flag; null when not measured",
          "title": "Value"
        }
      },
      "required": [
        "id",
        "label",
        "level",
        "message"
      ],
      "title": "Metric",
      "type": "object"
    },
    "Moment": {
      "additionalProperties": true,
      "description": "The findings about one moment, together: what a person looks at once.",
      "properties": {
        "end": {
          "title": "End",
          "type": "number"
        },
        "intervals": {
          "description": "Indexes into problem_intervals; the first speaks for the moment",
          "items": {
            "type": "integer"
          },
          "title": "Intervals",
          "type": "array"
        },
        "severity": {
          "description": "The worst of its findings",
          "enum": [
            "check",
            "poor"
          ],
          "title": "Severity",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "number"
        }
      },
      "required": [
        "start",
        "end",
        "severity",
        "intervals"
      ],
      "title": "Moment",
      "type": "object"
    },
    "NotMeasured": {
      "additionalProperties": true,
      "description": "A measure that couldn't be taken, and why.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "id",
        "label",
        "reason"
      ],
      "title": "NotMeasured",
      "type": "object"
    },
    "Overall": {
      "additionalProperties": true,
      "description": "The verdict: any Poor → poor; otherwise any Check → check; otherwise good.",
      "properties": {
        "counts": {
          "$ref": "#/$defs/Counts"
        },
        "headline": {
          "title": "Headline",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "level": {
          "enum": [
            "good",
            "check",
            "poor"
          ],
          "title": "Level",
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "sure": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Sure",
          "type": "array"
        }
      },
      "required": [
        "level",
        "label",
        "headline",
        "counts"
      ],
      "title": "Overall",
      "type": "object"
    },
    "Project": {
      "additionalProperties": true,
      "description": "What was evaluated.",
      "properties": {
        "dub_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "A dub given as a file: its path, hashed (reviewer votes use it)",
          "title": "Dub Id"
        },
        "duration_sec": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Sec"
        },
        "evaluated_video": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evaluated Video"
        },
        "is_lipsync": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Is Lipsync"
        },
        "perso_seq": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Perso Seq"
        },
        "share_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The Perso share link, when the input was one",
          "title": "Share Url"
        },
        "source_language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Language"
        },
        "target_language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Language"
        },
        "target_language_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Language Code"
        },
        "timestamp": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Timestamp"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "whisper_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Whisper Model"
        }
      },
      "required": [
        "title"
      ],
      "title": "Project",
      "type": "object"
    },
    "Report": {
      "additionalProperties": true,
      "description": "The report: verdict, every measure, every problem interval, in one interface language.",
      "properties": {
        "lang": {
          "enum": [
            "en",
            "ko",
            "pt",
            "es"
          ],
          "title": "Lang",
          "type": "string"
        },
        "method": {
          "additionalProperties": true,
          "title": "Method",
          "type": "object"
        },
        "moments": {
          "description": "problem_intervals grouped by moment",
          "items": {
            "$ref": "#/$defs/Moment"
          },
          "title": "Moments",
          "type": "array"
        },
        "not_measured": {
          "items": {
            "$ref": "#/$defs/NotMeasured"
          },
          "title": "Not Measured",
          "type": "array"
        },
        "overall": {
          "$ref": "#/$defs/Overall"
        },
        "possible_asr_errors": {
          "description": "Issues that are probably misheard words, not dub errors",
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Possible Asr Errors",
          "type": "array"
        },
        "problem_intervals": {
          "items": {
            "$ref": "#/$defs/Interval"
          },
          "title": "Problem Intervals",
          "type": "array"
        },
        "problem_seconds": {
          "description": "Seconds of the video covered by problem intervals",
          "title": "Problem Seconds",
          "type": "number"
        },
        "project": {
          "$ref": "#/$defs/Project"
        },
        "report_version": {
          "title": "Report Version",
          "type": "integer"
        },
        "score": {
          "anyOf": [
            {
              "$ref": "#/$defs/Score"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The quality score out of 100 (reports since 0.1.8)"
        },
        "sections": {
          "items": {
            "$ref": "#/$defs/Section"
          },
          "title": "Sections",
          "type": "array"
        },
        "skipped": {
          "description": "not_measured grouped by reason, each {title, reason, action, labels, ids, banner}",
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Skipped",
          "type": "array"
        },
        "things_to_check": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Things To Check",
          "type": "array"
        }
      },
      "required": [
        "report_version",
        "lang",
        "project",
        "overall",
        "sections",
        "problem_intervals",
        "possible_asr_errors",
        "problem_seconds",
        "things_to_check",
        "not_measured",
        "method"
      ],
      "title": "Report",
      "type": "object"
    },
    "Score": {
      "additionalProperties": true,
      "description": "The quality score out of 100: a summary next to the verdict, never instead of it, and never part of the\ncompare decision rule.",
      "properties": {
        "coverage": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How much of what applies to this dub was measured, in %: checks that don't apply are left out of it; under report.COVERAGE_MIN the score is provisional",
          "title": "Coverage"
        },
        "display": {
          "title": "Display",
          "type": "string"
        },
        "lost": {
          "description": "The checks that lost points, biggest first: id, label, level, lost (a Poor one at least its report.POOR_COSTS), severity (a Poor one's: unusable, serious, minor), why (the check's result), display",
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Lost",
          "type": "array"
        },
        "lost_display": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The heading over the list, with the sum",
          "title": "Lost Display"
        },
        "lost_how": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "How a check loses points, in one sentence",
          "title": "Lost How"
        },
        "lost_total": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "All the points lost: 100 minus this is the score (up to rounding)",
          "title": "Lost Total"
        },
        "measured_weight": {
          "description": "The weight of the sections that were measured, out of 100",
          "title": "Measured Weight",
          "type": "integer"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "parts": {
          "items": {
            "$ref": "#/$defs/ScorePart"
          },
          "title": "Parts",
          "type": "array"
        },
        "poor_cost": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "What Poor results cost beyond their own share (each costs at least report.POOR_COSTS by its POOR_SEVERITY): value = raw - poor_cost, rounded, never below 0, and at most 99 unless the verdict is Good",
          "title": "Poor Cost"
        },
        "provisional": {
          "default": false,
          "description": "The translation check didn't run, or less than report.COVERAGE_MIN % of what applies was measured",
          "title": "Provisional",
          "type": "boolean"
        },
        "raw": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The weighted sum of the checks, before what Poor results cost beyond their share",
          "title": "Raw"
        },
        "rule": {
          "description": "How the score is worked out, with the weights",
          "title": "Rule",
          "type": "string"
        },
        "rule_short": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The same in one line, for the text report",
          "title": "Rule Short"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "0-100; None when no weighted check was graded",
          "title": "Value"
        }
      },
      "required": [
        "measured_weight",
        "parts",
        "display",
        "message",
        "rule"
      ],
      "title": "Score",
      "type": "object"
    },
    "ScoreItem": {
      "additionalProperties": true,
      "description": "One check's share of the quality score: the section's share split evenly among its graded checks.",
      "properties": {
        "absent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Why it has no level: na (doesn't apply to this dub: no share, its points shared), missing (couldn't be measured: shared too, and the score's coverage drops) or dub (the dub itself made it impossible: counts as 0); None when graded",
          "title": "Absent"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The share and points alone, without the level",
          "title": "Detail"
        },
        "display": {
          "title": "Display",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "level": {
          "title": "Level",
          "type": "string"
        },
        "points": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The points it adds",
          "title": "Points"
        },
        "share": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Its share of the score, in %; None when not measured",
          "title": "Share"
        }
      },
      "required": [
        "id",
        "label",
        "level",
        "display"
      ],
      "title": "ScoreItem",
      "type": "object"
    },
    "ScorePart": {
      "additionalProperties": true,
      "description": "One section's share of the quality score.",
      "properties": {
        "applies": {
          "default": true,
          "description": "False when nothing in it applies to this dub: its weight is shared and the coverage doesn't count it",
          "title": "Applies",
          "type": "boolean"
        },
        "checks": {
          "description": "Checks counted in the section: graded, or 0 because of the dub",
          "title": "Checks",
          "type": "integer"
        },
        "contribution": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The points it adds to the score",
          "title": "Contribution"
        },
        "display": {
          "title": "Display",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "items": {
          "description": "The section's checks, each with its share",
          "items": {
            "$ref": "#/$defs/ScoreItem"
          },
          "title": "Items",
          "type": "array"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "of_display": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Its points of the most it could get, under a heading that names the unit (22.5 of 31.6); None when not counted",
          "title": "Of Display"
        },
        "points": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The section's own score, 0-100; None when nothing was graded",
          "title": "Points"
        },
        "share": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Its weight among the sections that were measured, in %",
          "title": "Share"
        },
        "weight": {
          "description": "Its published weight out of 100 (report.SCORE_WEIGHTS)",
          "title": "Weight",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "label",
        "weight",
        "checks",
        "display"
      ],
      "title": "ScorePart",
      "type": "object"
    },
    "Section": {
      "additionalProperties": true,
      "description": "A group of measures (timing and audio, speech, alignment, translation, file, lip movement).",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "metrics": {
          "items": {
            "$ref": "#/$defs/Metric"
          },
          "title": "Metrics",
          "type": "array"
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        },
        "title": {
          "title": "Title",
