<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What the hardened runtime lets DubEval do (package.json build.mac, after-pack.js). Electron's JavaScript engine and
     the bundled Python's compiled audio code (numba) write machine code while they run, and Python's ctypes makes
     small callbacks in memory. Nothing else is allowed: every library the app loads carries ESTsoft's signature. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
