# Copy to .env (never commit .env). All values are optional.

# Translation check (five scores per line: meaning, naturalness, context, terms, localization). It runs
# automatically when a key is set, with the first judge available: Claude, then Gemini, then ChatGPT, then a local
# model (see DUBEVAL_JUDGE below). Without any, the report shows the translation check as "not measured";
# everything else still works.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# low ≈ 3 s per review, high ≈ 40 s
GEMINI_THINKING=low

ANTHROPIC_API_KEY=
CLAUDE_JUDGE_MODEL=claude-opus-5-5

OPENAI_API_KEY=

# Speech recognition model. auto (the default): large-v3-turbo on an NVIDIA GPU when it is downloaded, else base
# (145 MB, fast). Set a name (base, small, medium, large-v3-turbo) to always use that one.
# WHISPER_MODEL=auto

# Number of app run folders (reports) kept in data/output/runs/.
MAX_KEPT_RUNS=10
# Share links whose downloads and speech recognition stay cached (data/cache/)
MAX_CACHED_LINKS=20
# REST API (qa.py serve): required to listen beyond this machine; clients send Authorization: Bearer <token>
# DUBEVAL_API_TOKEN=
# Where data (outputs, cache, history, votes, jobs) is kept; default ./data (the Docker image uses /data)
# DUBEVAL_DATA=

# Who checks the translation: auto (Claude, then Gemini, then ChatGPT, then a local model), claude, gemini,
# openai, ollama, or off.
# DUBEVAL_JUDGE=auto
# A local judge through Ollama (nothing leaves this computer):
# DUBEVAL_OLLAMA_URL=http://127.0.0.1:11434
# DUBEVAL_OLLAMA_MODEL=qwen3:8b
# Turn off the offline meaning screen (BGE-M3):
# DUBEVAL_MEANING_SCREEN=off
